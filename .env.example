# Copy to .env — docker compose reads it automatically.
# The only required value: the vectorlink admin secret (no default).
VECTORLINK_ADMIN_SECRET=root

# Optional: TerminusDB admin password in the dev stack (default root).
# TERMINUSDB_ADMIN_PASS=root

# Optional: bound on cached domain dataset handles (LRU, default 128).
# VECTORLINK_DATASET_CACHE_MAX=128
