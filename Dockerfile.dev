# Lightweight dev/E2E runtime image for tdb-search.
#
# Assembles in SECONDS: no in-container cargo build. Expects a STRIPPED debug
# binary at target/debug/tdb-search-stripped (produced by `make dev-image`).
# Stripping reduces size from ~1.2GB to ~30MB, making the image tiny and fast.
#
# Contract: identical runtime environment to the production Dockerfile —
# same base image, same non-root user, same env vars, same port, same
# tokenizer asset path. Only the binary differs (debug profile vs production).
#
# Usage:
#   make dev                  # build debug binary (~seconds, incremental)
#   make dev-image            # strip + assemble this image (~5 seconds)
#   docker compose up         # starts the fast dev container
#
# For the pristine production image, use `Dockerfile` directly (release/LTO).

FROM debian:trixie-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
  && rm -rf /var/lib/apt/lists/*

# Copy the STRIPPED debug binary from the host build context.
# Stripped: ~30MB vs 1.2GB full debug — fast context transfer + tiny image.
COPY target/debug/tdb-search-stripped /usr/local/bin/tdb-search

# Tokenizer asset (same location as production image).
COPY assets/tokenizer.json.bz2 /opt/tdb-search/tokenizer.json.bz2

# Non-root user for security (same as production Dockerfile).
RUN useradd -r -s /bin/false tdb-search

# Data directory for LanceDB datasets (owned by tdb-search user).
RUN mkdir -p /data && chown tdb-search:tdb-search /data

USER tdb-search

ENV TDB_SEARCH_TOKENIZER_PATH=/opt/tdb-search/tokenizer.json.bz2
ENV TDB_SEARCH_DATA_DIR=/data

EXPOSE 8080

ENTRYPOINT ["tdb-search"]
